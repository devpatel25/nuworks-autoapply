# ── Secrets / credentials — NEVER commit ─────────────────────────────────────
.env
session.json

# ── Personal data (per-user; create from the *.example.* templates) ──────────
data/*
!data/.gitkeep
!data/profile.example.json
# Your real, filled base résumés (the *.example.tex templates stay tracked):
resume_templates/Resume_SWE_General.tex
resume_templates/Resume_AI-ML_General.tex
resume_templates/memory.txt
resume_templates/project_bank.md

# ── Generated outputs (regenerated each run; personal) ───────────────────────
documents/
resumes/
cover_letters/
applications/
analysis/
logs/

# ── launchd schedule files (machine-specific paths + username) ───────────────
*.plist

# ── Python / OS noise ────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.DS_Store

# pdflatex artifacts from compiling the base templates by hand — showed up in claude -p git status
# and lured the tailor into reading resume_templates/ (denied → no output, 2026-10-15)
resume_templates/*.aux
resume_templates/*.log
resume_templates/*.out
resume_templates/*.pdf
resume_templates/*.synctex.gz
