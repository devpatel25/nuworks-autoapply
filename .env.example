# Copy this file to `.env` (which is gitignored) and fill in your own values.
# NEVER commit `.env`.

# Northeastern SSO login — used by job_scraper.py to log in to NUworks / Symplicity.
# (A school account with NUworks access. DUO 2FA is approved on your phone at run time.)
NEU_USERNAME=
NEU_PASSWORD=

# Telegram approval bot: create a bot via @BotFather to get the token,
# and get your numeric chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Optional ──────────────────────────────────────────────────────────────────
# Persistent Chrome profile dir for external-ATS autofill (defaults to ~/.external_apply_profile):
# EXTERNAL_APPLY_PROFILE=/Users/you/.external_apply_profile
# How long to wait for the DUO push approval before skipping (seconds):
# DUO_WAIT_SECONDS=300
# How many résumés to tailor concurrently up front (default 6):
# NUWORKS_TAILOR_PARALLELISM=6
